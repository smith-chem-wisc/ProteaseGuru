<?xml version="1.0"?>

<package>
	<metadata>
		<id>ProteaseGuru</id>
		<version>0.2.2</version>
		<title>ProteaseGuru</title>
		<authors>Rachel Miller, Nic Bollis, Peter Cruz Parrilla, Michael Shortreed</authors>
		<owners>Rachel Miller, Nic Bollis, Peter Cruz Parrilla, Michael Shortreed</owners>
		<license type="expression">LGPL-3.0-or-later</license>
		<projectUrl>https://github.com/smith-chem-wisc/ProteaseGuru</projectUrl>
		<icon>ProteaseGuruGui/icons/proteaseGuru.png</icon>
		<description>An in silico digestion tool for the planning of bottom-up proteomic experiments.</description>
		<tags>Chemistry Spectrometry Proteomics</tags>
		<dependencies>
			<group targetFramework="net10.0">
				<dependency id="mzLib" version="1.0.588" />
				<dependency id="Nett" version="0.15.0" />
				<dependency id="TopDownProteomics" version="0.0.298" />
			</group>
			<group targetFramework="net10.0-windows7.0">
				<dependency id="mzLib" version="1.0.588" />
				<dependency id="Nett" version="0.15.0" />
				<dependency id="TopDownProteomics" version="0.0.298" />
				<dependency id="OxyPlot.Core" version="2.2.0" />
				<dependency id="OxyPlot.Wpf" version="2.2.0" />
				<dependency id="OxyPlot.SkiaSharp" version="2.2.0" />
			</group>
		</dependencies>
	</metadata>
	<files>

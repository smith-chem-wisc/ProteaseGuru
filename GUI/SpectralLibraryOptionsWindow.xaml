<Window x:Class="GUI.SpectralLibraryOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:gui="clr-namespace:GUI"
        mc:Ignorable="d"
        Title="Spectral Library Export Options" Height="710" Width="600" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundColor" Color="#D5D5D5" />
        <SolidColorBrush x:Key="TextColor1" Color="#131313" />
        <SolidColorBrush x:Key="AccentColor" Color="#F9690E" />
        <SolidColorBrush x:Key="BorderColor" Color="DarkSlateGray"/>
        <gui:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <gui:NOTConverter x:Key="NOTConverter" />

        <!-- Style Expander -->
        <Style TargetType="Expander">
            <Setter Property="BorderThickness" Value="3 1 1 1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Background" Value="{StaticResource BackgroundColor}"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Margin" Value="15,5"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="Black" FontWeight="Bold"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Style GroupBox -->
        <Style TargetType="GroupBox">
            <Setter Property="BorderThickness" Value="4 1 1 1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Background" Value="{StaticResource BackgroundColor}"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Margin" Value="15,5"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="Black" FontWeight="Bold"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style TextBoxes -->
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="3 0 0 0"/>
        </Style>
        <Style TargetType="gui:DoubleTextBoxControl">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="3 0 0 0"/>
        </Style>

        <!-- Style Labels-->
        <Style x:Key="SectionHeaderStyle" TargetType="Label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor1}"/>
            <Setter Property="Margin" Value="5,10,0,5"/>
        </Style>

        <Style x:Key="PageGridStyle" TargetType="Grid">
            <Setter Property="Background" Value="{StaticResource BackgroundColor}"/>
        </Style>

        <Style x:Key="ImportantButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor1}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#131313" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#f58c49"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ListBoxItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Name="Border" Padding="2" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#fdd8c1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource ImportantButtonStyle}">
            <Setter Property="Width" Value="100"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid Style="{StaticResource PageGridStyle}" Margin="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical">

                <!-- Selection Boxes -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    
                    <!-- Protease Selection -->
                    <StackPanel Orientation="Vertical" Width="250">
                        <Label Content="Protease Selection (Multi-select)" Style="{StaticResource SectionHeaderStyle}"/>
                        <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="15,0,15,0">
                            <ListBox x:Name="lbProteases" 
                                     SelectionMode="Multiple"
                                     ItemContainerStyle="{StaticResource ListBoxItem}"
                                     Height="350"
                                     SelectionChanged="Proteases_SelectionChanged"
                                     BorderBrush="{StaticResource BorderColor}">
                            </ListBox>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="15,5">
                            <Button Content="Select All" Click="SelectAllProteases_Click" Style="{StaticResource SmallButtonStyle}" Margin="0,0,5,0"/>
                            <Button Content="Clear All" Click="ClearAllProteases_Click" Style="{StaticResource SmallButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Protein Selection -->
                    <StackPanel Orientation="Vertical" Width="250">
                        <Label Content="Protein Selection (Multi-select)" Style="{StaticResource SectionHeaderStyle}"/>

                        <DockPanel Margin="15,0,15,5">
                            <Label Content="Search:" DockPanel.Dock="Left" Width="60"/>
                            <TextBox x:Name="tbProteinSearch" 
                                 DockPanel.Dock="Right" 
                                 TextChanged="ProteinSearch_TextChanged"
                                 BorderBrush="{StaticResource BorderColor}"/>
                        </DockPanel>
                        <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Margin="15,0,15,0">
                            <ListBox x:Name="lbProteins" 
                                 SelectionMode="Multiple"
                                 ItemContainerStyle="{StaticResource ListBoxItem}"
                                 Height="319"
                                 SelectionChanged="Proteins_SelectionChanged"
                                 BorderBrush="{StaticResource BorderColor}">
                            </ListBox>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="15,5">
                            <Button Content="Select All" Click="SelectAllProteins_Click" Style="{StaticResource SmallButtonStyle}" Margin="0,0,5,0"/>
                            <Button Content="Clear All" Click="ClearAllProteins_Click" Style="{StaticResource SmallButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Fragment Intensity Prediction Options -->
                <Expander Header="Fragment Intensity Prediction Options" IsExpanded="True">
                    <StackPanel Orientation="Vertical" Background="{StaticResource BackgroundColor}">

                        <!-- Fragment Prediction Model -->
                        <StackPanel Orientation="Horizontal" Margin="15,5">
                            <Label Content="Model:" FontWeight="Bold" Margin="15,0" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cbFragmentModel" Margin="0,5" Width="200"
                                      SelectionChanged="FragmentModel_SelectionChanged" VerticalAlignment="Center">
                                <ComboBoxItem Content="Prosit 2020 Intensity HCD" IsSelected="True" IsEnabled="False" Tag="Prosit2020IntensityHCD" />
                            </ComboBox>
                        </StackPanel>

                        <!-- Charge States -->
                        <StackPanel Orientation="Horizontal" Margin="15,5">
                            <Label Content="Charge States to Predict:" FontWeight="Bold" Margin="15,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <CheckBox x:Name="cbCharge2" Content="2+" IsChecked="True" Margin="5,5" VerticalAlignment="Center"/>
                            <CheckBox x:Name="cbCharge3" Content="3+" IsChecked="True" Margin="5,5" VerticalAlignment="Center"/>
                            <CheckBox x:Name="cbCharge4" Content="4+" IsChecked="False" Margin="5,5" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Collision Energy -->
                        <StackPanel Orientation="Horizontal" Margin="15,5">
                            <Label Content="Collision Energy (NCE):" FontWeight="Bold" Margin="15,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <gui:IntegerTextBoxControl x:Name="tbCollisionEnergy" Width="60" Text="30" LowerBound="0" UpperBound="100" Margin="5,5"/>
                            <Label Content="%" Margin="5,0"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- Model Input Filtering Options -->
                <Expander Header="Peptide Filtering Options">
                    <StackPanel Orientation="Vertical" Margin="15,5">
                        <CheckBox x:Name="cbExcludeIncompatiblePeptides" Content="Exclude Incompatible Peptides" IsChecked="True" Margin="15,5" FontWeight="Bold">
                            <CheckBox.ToolTip>
                                <ToolTip Content="If checked, peptides with unsupported modifications will be excluded from the export. If unchecked, the unsupported modifications will be removed and a prediction will be generated." FontSize="10" Margin="35,0,5,5"/>
                            </CheckBox.ToolTip>
                        </CheckBox>
                        <CheckBox x:Name="cbExcludeUndetectablePeptides" Content="Exclude Undetectable Peptides" IsChecked="False" Margin="15,5" FontWeight="Bold">
                            <CheckBox.ToolTip>
                                <ToolTip Content="If checked, peptides predicted to have low detectability will be excluded." FontSize="10" Margin="35,0,5,5"/>
                            </CheckBox.ToolTip>
                        </CheckBox>
                    </StackPanel>
                </Expander>

                <!-- Model Output Filtering Options -->
                <Expander Header="Fragment Ion Filtering Options">
                    <StackPanel Orientation="Vertical" Margin="15,5">

                        <GroupBox Header="M/Z Filtering">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal" Margin="15,5">
                                    <Label Content="Minimum M/Z Threshold:" FontWeight="Bold" Margin="15,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <gui:DoubleTextBoxControl x:Name="tbMinMzThreshold" Width="60" Text="200" LowerBound="0" Margin="5,5">
                                        <gui:DoubleTextBoxControl.ToolTip>
                                            <ToolTip Content="Fragment ions with an m/z lower than this threshold will be excluded." FontSize="10" Margin="35,0,5,5"/>
                                        </gui:DoubleTextBoxControl.ToolTip>
                                    </gui:DoubleTextBoxControl>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="15,5">
                                    <Label Content="Maximum M/Z Threshold:" FontWeight="Bold" Margin="15,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <gui:DoubleTextBoxControl x:Name="tbMaxMzThreshold" Width="60" Text="2000" LowerBound="0" Margin="5,5">
                                        <gui:DoubleTextBoxControl.ToolTip>
                                            <ToolTip Content="Fragment ions with an m/z higher than this threshold will be excluded." FontSize="10" Margin="35,0,5,5"/>
                                        </gui:DoubleTextBoxControl.ToolTip>
                                    </gui:DoubleTextBoxControl>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Intensity Filtering">
                            <StackPanel Orientation="Vertical" Margin="15,5">

                                <CheckBox x:Name="cbEnableIntensityThresholdFiltering" Content="Filter Fragment Ion Intensities Relative to Max Intensity"
                                          FontWeight="Bold" IsChecked="True" Margin="15,0"/>
                                <StackPanel Orientation="Horizontal" Margin="15,5" Visibility="{Binding ElementName=cbEnableIntensityThresholdFiltering, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Label Content="Minimum Intensity Threshold (%):" Margin="15,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <gui:DoubleTextBoxControl x:Name="tbRelIntThreshold" Width="60" Text="1" LowerBound="0" UpperBound="100" Margin="5,5"/>
                                </StackPanel>

                                <CheckBox x:Name="cbEnableIntensityRankFiltering" Content="Keep Only the N Most Intense Fragment Ions"
                                          FontWeight="Bold" IsChecked="{Binding ElementName=cbEnableIntensityThresholdFiltering, Path=IsChecked, Converter={StaticResource NOTConverter}}" Margin="15,0"/>
                                <StackPanel Orientation="Horizontal" Margin="15,5" Visibility="{Binding ElementName=cbEnableIntensityRankFiltering, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Label Content="Top" Margin="15,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <gui:IntegerTextBoxControl x:Name="tbRankThreshold" Width="30" Text="12" AllowNegative="False" Margin="0,5"/>
                                    <Label Content="Most Intense Fragment Ions" Margin="0,5,0,5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </Expander>

                <!-- Output File Format -->
                <StackPanel Orientation="Horizontal" Margin="15,5">
                    <Label Content="File Format:" Margin="15,5" VerticalAlignment="Center" Style="{StaticResource SectionHeaderStyle}"/>
                    <ComboBox x:Name="cbOutputFormat" Margin="15,5" Width="200" VerticalAlignment="Center">
                        <ComboBoxItem Content="MSP Format (.msp)" IsSelected="True" IsEnabled="False" Tag="MSP"/>
                    </ComboBox>
                </StackPanel>

                <!-- Summary -->
                <Label Content="Selection Summary" HorizontalAlignment="Center" Style="{StaticResource SectionHeaderStyle}"/>
                <Border BorderBrush="#131313" BorderThickness="1" Margin="15,5" Padding="10" Width="350" Background="White">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="11" TextAlignment="Center">
                            <Run Text="Proteases: "/><Run x:Name="runProteaseCount" Text="0" FontWeight="Bold"/>
                            <LineBreak/>
                            <Run Text="Proteins: "/><Run x:Name="runProteinCount" Text="0" FontWeight="Bold"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
                    <Button x:Name="btnExport" Content="Export" Click="Export_Click" 
                            Style="{StaticResource ImportantButtonStyle}" Margin="5"/>
                    <Button x:Name="btnCancel" Content="Cancel" Click="Cancel_Click" 
                            Style="{StaticResource ImportantButtonStyle}" Margin="5"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

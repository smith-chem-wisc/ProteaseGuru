<Window x:Class="GUI.SpectralLibraryOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:gui="clr-namespace:GUI"
        mc:Ignorable="d"
        Title="Spectral Library Export Options" Height="750" Width="500">
    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundColor" Color="#D5D5D5" />
        <SolidColorBrush x:Key="TextColor1" Color="#131313" />
        <SolidColorBrush x:Key="AccentColor" Color="#F9690E" />

        <Style x:Key="SectionHeaderStyle" TargetType="Label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor1}"/>
            <Setter Property="Margin" Value="5,10,0,5"/>
        </Style>

        <Style x:Key="PageGridStyle" TargetType="Grid">
            <Setter Property="Background" Value="{StaticResource BackgroundColor}"/>
        </Style>

        <Style x:Key="ImportantButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor1}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#131313" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#f58c49"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ListBoxItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Name="Border" Padding="2" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#fdd8c1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource ImportantButtonStyle}">
            <Setter Property="Width" Value="100"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid Style="{StaticResource PageGridStyle}" Margin="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical">

                <!-- Protease Selection -->
                <Label Content="Protease Selection (Multi-select)" Style="{StaticResource SectionHeaderStyle}"/>
                <TextBlock Text="Hold Ctrl or Shift to select multiple proteases" 
                           Margin="15,0,0,5" 
                           FontSize="10" 
                           Foreground="DarkGray"/>
                <Border BorderBrush="#131313" BorderThickness="1" Margin="15,0,15,0">
                    <ListBox x:Name="lbProteases" 
                             SelectionMode="Multiple"
                             ItemContainerStyle="{StaticResource ListBoxItem}"
                             Height="120"
                             SelectionChanged="Proteases_SelectionChanged">
                    </ListBox>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="15,5">
                    <Button Content="Select All" Click="SelectAllProteases_Click" Style="{StaticResource SmallButtonStyle}" Margin="0,0,5,0"/>
                    <Button Content="Clear All" Click="ClearAllProteases_Click" Style="{StaticResource SmallButtonStyle}"/>
                </StackPanel>

                <!-- Protein Selection -->
                <Label Content="Protein Selection (Multi-select)" Style="{StaticResource SectionHeaderStyle}"/>
                <TextBlock Margin="15,0,0,5" FontSize="10" Foreground="DarkGray">
                    <Run Text="Hold Ctrl or Shift to select multiple proteins."/>
                    <LineBreak/>
                    <Run Text="Leave empty to export all proteins." FontWeight="Bold" Foreground="DarkOrange"/>
                </TextBlock>
                <DockPanel Margin="15,0,15,5">
                    <Label Content="Search:" DockPanel.Dock="Left" Width="60"/>
                    <TextBox x:Name="tbProteinSearch" 
                             DockPanel.Dock="Right" 
                             TextChanged="ProteinSearch_TextChanged"/>
                </DockPanel>
                <Border BorderBrush="#131313" BorderThickness="1" Margin="15,0,15,0">
                    <ListBox x:Name="lbProteins" 
                             SelectionMode="Multiple"
                             ItemContainerStyle="{StaticResource ListBoxItem}"
                             Height="150"
                             SelectionChanged="Proteins_SelectionChanged">
                    </ListBox>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="15,5">
                    <Button Content="Select All" Click="SelectAllProteins_Click" Style="{StaticResource SmallButtonStyle}" Margin="0,0,5,0"/>
                    <Button Content="Clear All" Click="ClearAllProteins_Click" Style="{StaticResource SmallButtonStyle}"/>
                </StackPanel>

                <!-- Fragment Prediction Model -->
                <Label Content="Fragment Prediction Model" Style="{StaticResource SectionHeaderStyle}"/>
                <ComboBox x:Name="cbFragmentModel" Margin="15,5" Width="300" HorizontalAlignment="Left"
                          SelectionChanged="FragmentModel_SelectionChanged">
                    <ComboBoxItem Content="Prosit 2020 Intensity HCD" IsSelected="True" IsEnabled="False" Tag="Prosit2020HCD"/>
                </ComboBox>

                <!-- Charge States -->
                <Label Content="Charge States to Predict" Style="{StaticResource SectionHeaderStyle}"/>
                <StackPanel Orientation="Horizontal" Margin="15,5">
                    <CheckBox x:Name="cbCharge2" Content="2+" IsChecked="True" Margin="0,0,15,0"/>
                    <CheckBox x:Name="cbCharge3" Content="3+" IsChecked="True" Margin="0,0,15,0"/>
                    <CheckBox x:Name="cbCharge4" Content="4+" IsChecked="False"/>
                </StackPanel>

                <!-- Collision Energy -->
                <Label Content="Collision Energy (NCE)" Style="{StaticResource SectionHeaderStyle}"/>
                <StackPanel Orientation="Horizontal" Margin="15,5">
                    <gui:IntegerTextBoxControl x:Name="tbCollisionEnergy" Width="60" Text="30" LowerBound="0" UpperBound="100"/>
                    <Label Content="%" Margin="5,0"/>
                </StackPanel>

                <!-- Intensity Threshold -->
                <Label Content="Minimum Intensity Threshold (%)" Style="{StaticResource SectionHeaderStyle}"/>
                <StackPanel Orientation="Horizontal" Margin="15,5">
                    <gui:DoubleTextBoxControl x:Name="tbIntensityThreshold" 
                                              Width="60" 
                                              Text="0.1"
                                              LowerBound="0"
                                              UpperBound="100">
                        <ToolTipService.ToolTip>
                            <ToolTip Content="Minimum relative intensity threshold (0-100%)"/>
                        </ToolTipService.ToolTip>
                    </gui:DoubleTextBoxControl>
                    <Label Content="%" Margin="5,0"/>
                </StackPanel>

                <!-- Output Format -->
                <Label Content="Output Format" Style="{StaticResource SectionHeaderStyle}"/>
                <ComboBox x:Name="cbOutputFormat" Margin="15,5" Width="300" HorizontalAlignment="Left">
                    <ComboBoxItem Content="MSP Format (.msp)" IsSelected="True" IsEnabled="False" Tag="MSP"/>
                </ComboBox>
                
                <!-- Model I/O Handling Options -->
                <Label Content="Model Input and Output Handling Options" Style="{StaticResource SectionHeaderStyle}"/>
                <StackPanel Orientation="Vertical" Margin="15,5">
                    <CheckBox x:Name="cbExcludeIncompatiblePeptides" Content="Exclude Incompatible Peptides" IsChecked="True"/>
                    <TextBlock Text="If unchecked, the unsupported modifications will be removed and a prediction will be generated." FontSize="10" Margin="20,0,0,5" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Summary -->
                <Label Content="Selection Summary" HorizontalAlignment="Center" Style="{StaticResource SectionHeaderStyle}"/>
                <Border BorderBrush="#131313" BorderThickness="1" Margin="15,5" Padding="10" Width="350" Background="White">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="11" TextAlignment="Center">
                            <Run Text="Proteases: "/><Run x:Name="runProteaseCount" Text="0" FontWeight="Bold"/>
                            <LineBreak/>
                            <Run Text="Proteins: "/><Run x:Name="runProteinCount" Text="0" FontWeight="Bold"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
                    <Button x:Name="btnExport" Content="Export" Click="Export_Click" 
                            Style="{StaticResource ImportantButtonStyle}" Margin="5"/>
                    <Button x:Name="btnCancel" Content="Cancel" Click="Cancel_Click" 
                            Style="{StaticResource ImportantButtonStyle}" Margin="5"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

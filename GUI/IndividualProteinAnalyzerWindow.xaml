<UserControl x:Class="GUI.IndividualProteinAnalyzerWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:gui="clr-namespace:GUI"
             d:DesignHeight="600" d:DesignWidth="1200">
    <UserControl.Resources>

        <SolidColorBrush x:Key="BackgroundColor" Color="#D5D5D5" />
        <SolidColorBrush x:Key="TextColor1" Color="#131313" />
        <SolidColorBrush x:Key="AccentColor" Color="#F9690E" />
        <SolidColorBrush x:Key="DataGridBackgroundColor" Color="#D5D5D5" />
        <SolidColorBrush x:Key="BorderColor" Color="#444449" />

        <!--Styling for the grid that defines each page-->
        <Style x:Key="PageGridStyle" TargetType="Grid">
            <Setter Property="Background" Value="{StaticResource BackgroundColor}"/>
            <Setter Property="Margin" Value="-3,-2,-2,-2"/>
        </Style>
        <!--Styling for the "important" buttons like add task, add DB, etc.-->
        <Style x:Key="ImportantButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor1}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#131313" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#f58c49"/>
                    <Setter Property="BorderBrush" Value="#131313"/>
                    <Setter Property="Foreground" Value="#131313"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!--Styling for the big text header at the top of each page-->
        <Style x:Key="HeaderLabelStyle" TargetType="Label">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor1}"/>
            <Setter Property="Margin" Value="10,5,0,0"/>
        </Style>
        <!--Styling for the "main" text in the About + Help pages-->
        <Style x:Key="TextBlockStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextColor1}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="WrapWithOverflow" />
            <Setter Property="Margin" Value="15,0,10,0"/>
        </Style>
        <Style x:Key="InternalGridStyle" TargetType="Grid">
            <Setter Property="Background" Value="{StaticResource BackgroundColor}"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>
        <Style x:Key="ListBoxItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Name="Border" Padding="2" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#fdd8c1"></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SmallHeaderLabelStyle" TargetType="Label">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor1}"/>
            <Setter Property="Margin" Value="5,2,0,0"/>
        </Style>
        <Style x:Key="ModeToggleStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>
    <Grid Style="{StaticResource PageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--Header label-->
        <Label Content="Individual Protein Analyzer" Grid.Row="0" Style="{StaticResource HeaderLabelStyle}" />

        <!--Detail text-->
        <TextBlock Grid.Row="1" Style="{StaticResource TextBlockStyle}">
            Search for a specific protein accessions to view its digestion results both numerically and as a protein sequence coverage map.
        </TextBlock>

        <Grid Grid.Row ="2" Style="{StaticResource InternalGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Style="{StaticResource InternalGridStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="3"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Row="0" Background="{StaticResource DataGridBackgroundColor}">
                    <Label Height="30" DockPanel.Dock="Left">Search</Label>
                    <TextBox Name="SearchTextBox" TextChanged="Search_TextChanged" DockPanel.Dock="Right"></TextBox>
                </DockPanel>
                <Label Content="Protein Accessions" Grid.Row="1" Style="{StaticResource SmallHeaderLabelStyle}" />

                <Grid Grid.Row="2" Style="{StaticResource InternalGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height=".9*"/>
                    </Grid.RowDefinitions>

                    <ListBox Name ="dataGridProteins" SelectionMode="Single" ItemContainerStyle="{StaticResource ListBoxItem}" SelectionChanged="proteins_SelectedCellsChanged"></ListBox>

                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Center"
                          Background="{StaticResource BackgroundColor}"
                          Width="3"/>

            <!-- Column 2: Protease Options -->
            <DockPanel Grid.Column="2" Background="{StaticResource BackgroundColor}" LastChildFill="True">
                <Label DockPanel.Dock="Top"
                       Content="Protease Options"
                       Style="{StaticResource SmallHeaderLabelStyle}"
                       HorizontalContentAlignment="Center"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ProteaseOptionsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <gui:ProteaseSpecificDigestionControl/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <GridSplitter Grid.Column="3"
                          HorizontalAlignment="Center"
                          Background="{StaticResource BackgroundColor}"
                          Width="3"/>

            <Grid Grid.Column="4" Name="AllResultsGrid" Style="{StaticResource InternalGridStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Export Spectrum Library panel -->
                    <RowDefinition Height="3"/>
                    <!-- separator -->
                    <RowDefinition Height="*"/>
                    <!-- Max Coverage section -->
                </Grid.RowDefinitions>

                <!-- ═══════════════════════════════════════════════════
                     Export Spectrum Library panel
                     ═══════════════════════════════════════════════════ -->
                <Border Grid.Row="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1"
                        Background="{StaticResource BackgroundColor}" Padding="5,4,5,6">
                    <StackPanel Orientation="Vertical">

                        <!-- Row 0: header + button -->
                        <DockPanel LastChildFill="False">
                            <Label DockPanel.Dock="Left" Content="Export Spectrum Library"
                                   Style="{StaticResource SmallHeaderLabelStyle}" Margin="0,0,0,0"/>
                            <Button x:Name="ExportSpectrumLibraryButton"
                                    DockPanel.Dock="Right"
                                    Content="Export Spectrum Library"
                                    Style="{StaticResource ImportantButtonStyle}"
                                    Width="180" Height="24"
                                    Click="ExportSpectrumLibrary_Click"/>
                        </DockPanel>

                        <!-- Row 1: NCE + Charge states -->
                        <StackPanel Orientation="Horizontal" Margin="5,2,0,0">

                            <!-- NCE drop-down: Prosit 2020 HCD calibrated values only -->
                            <Label Content="NCE:" VerticalAlignment="Center" FontSize="12" Padding="0,0,4,0"/>
                            <ComboBox x:Name="NceComboBox"
                                      Width="52" Height="22"
                                      FontSize="12"
                                      VerticalContentAlignment="Center"
                                      ToolTip="Normalised Collision Energy — Prosit 2020 HCD calibrated values only."
                                      Margin="0,0,18,0"
                                      SelectedIndex="3">
                                <ComboBoxItem Content="20"/>
                                <ComboBoxItem Content="23"/>
                                <ComboBoxItem Content="25"/>
                                <ComboBoxItem Content="28"/>
                                <ComboBoxItem Content="30"/>
                                <ComboBoxItem Content="35"/>
                            </ComboBox>

                            <!-- Charge state multi-select -->
                            <Label Content="Charge states:" VerticalAlignment="Center" FontSize="12" Padding="0,0,6,0"/>
                            <CheckBox x:Name="chk1" Content="1" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                            <CheckBox x:Name="chk2" Content="2" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" IsChecked="True"/>
                            <CheckBox x:Name="chk3" Content="3" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" IsChecked="True"/>
                            <CheckBox x:Name="chk4" Content="4" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                            <CheckBox x:Name="chk5" Content="5" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                            <CheckBox x:Name="chk6" Content="6" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                            <CheckBox x:Name="chk7" Content="7" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"
                                      ToolTip="Charge 7 is not supported by Prosit_2020_intensity_HCD and will be ignored."/>
                        </StackPanel>

                        <!-- Row 2: status label -->
                        <TextBlock x:Name="ExportStatusLabel"
                                   Text="" FontSize="11" FontStyle="Italic"
                                   Foreground="#555555" Margin="5,3,0,0"
                                   TextWrapping="NoWrap"/>
                    </StackPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="3" HorizontalAlignment="Stretch"
                              Background="{StaticResource BackgroundColor}" ResizeDirection="Rows"/>

                <!-- Maximum Coverage Analysis fills the rest -->
                <Grid Grid.Row="2" Name="MaxCoverageGrid" SizeChanged="maxCoverageGrid_SizeChanged"
                      Style="{StaticResource InternalGridStyle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <!-- Section header -->
                        <RowDefinition Height="30"/>
                        <!-- Radio buttons -->
                        <RowDefinition Height="*"/>
                        <!-- Map + legend -->
                    </Grid.RowDefinitions>

                    <Label Content="Maximum Coverage Analysis" Grid.Row="0"
                           Style="{StaticResource SmallHeaderLabelStyle}"/>

                    <!-- Mode radio buttons -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="5,0,0,0">
                        <RadioButton x:Name="greedyToggle" Content="Greedy (Min Set)"
                                     GroupName="MaxCovMode" Width="120"
                                     IsChecked="True" Checked="MaxCoverageMode_Changed"
                                     Style="{StaticResource ModeToggleStyle}"/>
                        <RadioButton x:Name="singleToggle" Content="Best Single"
                                     GroupName="MaxCovMode"
                                     Checked="MaxCoverageMode_Changed"
                                     Style="{StaticResource ModeToggleStyle}"/>
                        <RadioButton x:Name="pairToggle" Content="Best Pair"
                                     GroupName="MaxCovMode"
                                     Checked="MaxCoverageMode_Changed"
                                     Style="{StaticResource ModeToggleStyle}"/>
                        <RadioButton x:Name="tripletToggle" Content="Best Triplet"
                                     GroupName="MaxCovMode"
                                     Checked="MaxCoverageMode_Changed"
                                     Style="{StaticResource ModeToggleStyle}"/>
                        <TextBlock x:Name="computingLabel"
                                   Text="  ⟳  Computing optimal coverage…"
                                   FontStyle="Italic" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="#888888" Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Scrollable map + legend -->
                    <ScrollViewer Grid.Row="2" Name="maxCoverageMapViewer"
                                  HorizontalAlignment="Center" VerticalAlignment="Top"
                                  CanContentScroll="True"
                                  VerticalScrollBarVisibility="Visible" Width="775">
                        <Grid Name="maxCoverageMapGrid" Background="White">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Canvas x:Name="maxCoverageMap" Grid.Row="0" Width="700" Background="White"/>
                            <Canvas x:Name="maxCoverageLegend" Grid.Row="1" Width="700" Background="White"
                                    VerticalAlignment="Top" HorizontalAlignment="Left">
                                <Grid Name="maxCoverageLegendGrid" Background="White"
                                      VerticalAlignment="Top" HorizontalAlignment="Left"/>
                            </Canvas>
                            <!-- Coverage key: explains Bold / Underline text styles -->
                            <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="1"
                                    Background="#F8F8F8" Margin="5,6,5,6" Padding="8,5,8,5"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Key: " FontSize="12" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="A" FontSize="14" FontWeight="Bold"
                                               FontFamily="Arial" VerticalAlignment="Center"
                                               Foreground="Black"/>
                                    <TextBlock Text=" Covered  " FontSize="12"
                                               VerticalAlignment="Center" Margin="2,0,10,0"/>
                                    <TextBlock FontSize="14" FontFamily="Arial"
                                               VerticalAlignment="Center" Foreground="Black">
                                        <Run Text="A" TextDecorations="Underline"/>
                                    </TextBlock>
                                    <TextBlock Text=" Not Covered" FontSize="12"
                                               VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>

            </Grid>

        </Grid>
    </Grid>
</UserControl>


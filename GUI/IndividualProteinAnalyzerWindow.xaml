<UserControl x:Class="GUI.IndividualProteinAnalyzerWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             xmlns:gui="clr-namespace:GUI"
             d:DesignHeight="600" d:DesignWidth="1200">
    <UserControl.Resources>

        <SolidColorBrush x:Key="BackgroundColor" Color="#D5D5D5" />
        <SolidColorBrush x:Key="TextColor1" Color="#131313" />
        <SolidColorBrush x:Key="AccentColor" Color="#F9690E" />
        <SolidColorBrush x:Key="DataGridBackgroundColor" Color="#D5D5D5" />

        <!--Styling for the grid that defines each page-->
        <Style x:Key="PageGridStyle" TargetType="Grid">
            <Setter Property="Background" Value="{StaticResource BackgroundColor}"/>
            <Setter Property="Margin" Value="-3,-2,-2,-2"/>
        </Style>
        <!--Styling for the "important" buttons like add task, add DB, etc.-->
        <Style x:Key="ImportantButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor1}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#131313" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#f58c49"/>
                    <Setter Property="BorderBrush" Value="#131313"/>
                    <Setter Property="Foreground" Value="#131313"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!--Styling for the big text header at the top of each page-->
        <Style x:Key="HeaderLabelStyle" TargetType="Label">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor1}"/>
            <Setter Property="Margin" Value="10,5,0,0"/>
        </Style>
        <!--Styling for the "main" text in the About + Help pages-->
        <Style x:Key="TextBlockStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextColor1}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="WrapWithOverflow" />
            <Setter Property="Margin" Value="15,0,10,0"/>
        </Style>
        <Style x:Key="InternalGridStyle" TargetType="Grid">
            <Setter Property="Background" Value="{StaticResource BackgroundColor}"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>
        <Style x:Key="ListBoxItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Name="Border" Padding="2" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#fdd8c1"></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SmallHeaderLabelStyle" TargetType="Label">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor1}"/>
            <Setter Property="Margin" Value="5,2,0,0"/>
        </Style>
    </UserControl.Resources>
    <Grid Style="{StaticResource PageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--Header label-->
        <Label Content="Individual Protein Analyzer" Grid.Row="0" Style="{StaticResource HeaderLabelStyle}" />

        <!--Detail text-->
        <TextBlock Grid.Row="1" Style="{StaticResource TextBlockStyle}">
            Search for a specific protein accessions to view its digestion results both numerically and as a protein sequence coverage map.
        </TextBlock>

        <Grid Grid.Row ="2" Style="{StaticResource InternalGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Style="{StaticResource InternalGridStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="3"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Row="0" Background="{StaticResource DataGridBackgroundColor}">
                    <Label Height="30" DockPanel.Dock="Left">Search</Label>
                    <TextBox Name="SearchTextBox" TextChanged="Search_TextChanged" DockPanel.Dock="Right"></TextBox>
                </DockPanel>
                <Label Content="Protein Accessions" Grid.Row="1" Style="{StaticResource SmallHeaderLabelStyle}" />

                <Grid Grid.Row="2" Style="{StaticResource InternalGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height=".9*"/>
                    </Grid.RowDefinitions>

                    <ListBox Name ="dataGridProteins" SelectionMode="Single" ItemContainerStyle="{StaticResource ListBoxItem}" SelectionChanged="proteins_SelectedCellsChanged"></ListBox>

                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" 
                          HorizontalAlignment="Center"
                          Background="{StaticResource BackgroundColor}"
                          Width="3"/>

            <Grid Grid.Column="2" Style="{StaticResource InternalGridStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"></RowDefinition>
                    <RowDefinition Height = "*"></RowDefinition>
                    <RowDefinition Height = "30"></RowDefinition>
                    <RowDefinition Height="1"></RowDefinition>
                    <RowDefinition Height="30"></RowDefinition>
                </Grid.RowDefinitions>
                <!--Header label-->
                <Label Content="Protease Options" Grid.Row="0" Style="{StaticResource SmallHeaderLabelStyle}"  HorizontalContentAlignment="Center"/>


            </Grid>

            <GridSplitter Grid.Column="3" 
                          HorizontalAlignment="Center"
                          Background="{StaticResource BackgroundColor}"
                          Width="3"/>

            <Grid Grid.Column="4" Name="AllResultsGrid" Style="{StaticResource InternalGridStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="2*"></RowDefinition>
                </Grid.RowDefinitions>

                <!-- Row 2: Protein Sequence Coverage Map (existing) -->
                <Grid Grid.Row="2" Name="ResultsGrid" SizeChanged="resultsSizeChanged"
                      Style="{StaticResource InternalGridStyle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>
                    <Label Content="Protein Sequence Coverage Map" Grid.Row="0" Style="{StaticResource SmallHeaderLabelStyle}"/>
                    <ScrollViewer Grid.Row="1" Name="mapViewer" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  CanContentScroll="True" VerticalScrollBarVisibility="Visible" Width="775">
                        <Grid Name="mapGrid" Background="White">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Canvas x:Name="map" Grid.Row="0" Width="700" Background="White"/>
                            <Canvas x:Name="legend" Grid.Row="1" Width="700" Height="300" Background="White"
                                    VerticalAlignment="Top" HorizontalAlignment="Left">
                                <Grid Name="legendGrid" Background="White" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                            </Canvas>
                        </Grid>
                    </ScrollViewer>
                    <Button x:Name="exportPngButton" Content="Export Protein Digestion Results"
                            Click="exportCoverageMap" Grid.Row="3" Width="250"
                            Style="{StaticResource ImportantButtonStyle}"/>
                </Grid>

                <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch"
                              Background="{StaticResource BackgroundColor}" ResizeDirection="Rows"/>

                <!-- Row 4: Maximum Coverage Map (replace the entire MaxCoverageGrid) -->
                <Grid Grid.Row="4" Name="MaxCoverageGrid" SizeChanged="maxCoverageGrid_SizeChanged"
                      Style="{StaticResource InternalGridStyle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <!-- Header                          -->
                        <RowDefinition Height="30"/>
                        <!-- Toggle buttons + spinner        -->
                        <RowDefinition Height="*"/>
                        <!-- Canvas: title+label+seq+legend  -->
                    </Grid.RowDefinitions>

                    <Label Content="Maximum Coverage Analysis" Grid.Row="0"
                           Style="{StaticResource SmallHeaderLabelStyle}"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="5,0,0,0">
                        <RadioButton x:Name="greedyToggle" Content="Greedy (Min Set)"
                                     GroupName="MaxCovMode" Width="120"
                                     IsChecked="True" Checked="MaxCoverageMode_Changed"
                                     Style="{StaticResource ModeToggleStyle}"/>
                        <RadioButton x:Name="pairToggle" Content="Best Pair"
                                     GroupName="MaxCovMode"
                                     Checked="MaxCoverageMode_Changed"
                                     Style="{StaticResource ModeToggleStyle}"/>
                        <RadioButton x:Name="tripletToggle" Content="Best Triplet"
                                     GroupName="MaxCovMode"
                                     Checked="MaxCoverageMode_Changed"
                                     Style="{StaticResource ModeToggleStyle}"/>
                        <TextBlock x:Name="computingLabel"
                                   Text="  ⟳  Computing optimal coverage…"
                                   FontStyle="Italic" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="#888888" Visibility="Collapsed"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" Name="maxCoverageMapViewer"
                                  HorizontalAlignment="Center" VerticalAlignment="Top"
                                  CanContentScroll="True"
                                  VerticalScrollBarVisibility="Visible" Width="775">
                        <Grid Name="maxCoverageMapGrid" Background="White">
                            <Canvas x:Name="maxCoverageMap" Width="700" Background="White"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
                
            </Grid>

        </Grid>
    </Grid>
    </UserControl>

